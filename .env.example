# Surf Nativo — environment variables
# Copy this file to `.env.local` and fill in real values for local dev.
# In production, set these in your hosting provider (Vercel / Netlify / etc.).

# Public URL of the Laravel backend (Sanctum + REST API).
# Used by the frontend to fetch products, categories and authenticate.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8087/api/v1

# Public URL where this Next.js app is served.
# Used for canonical links, OG metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
