# Surf Nativo — variables de entorno
# Copiar a `.env.local` y completar para desarrollo local.
# En producción (Coolify) se cargan en Environment Variables del recurso y
# llegan al Dockerfile como build args: Next las hornea en el bundle durante
# `next build`, así que cambiarlas exige redeploy. Ver docs/deploy-coolify.md.

# URL pública del backend Laravel (REST + Sanctum). La usa el frontend para
# productos, categorías, chat y login. Obligatoria en producción.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8087/api/v1

# URL pública donde se sirve esta app. Se usa para canonicals, OG metadata,
# sitemap.xml y robots.txt. Obligatoria en producción (https://surfnativo.uy).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
